generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  username     String        @unique
  email        String        @unique
  password     String
  ranks        Rank[]
  schedule     Schedule[]
  favTeamLists FavTeamList[]
}

model Rank {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  sport     String
  order     String[]
}

model Schedule {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  User      User      @relation(fields: [userId], references: [id])
  userId    String    @db.ObjectId
  sport     String
  schedule  NFLGame[]
}

type NFLGame {
  Away   String
  Home   String
  Week   Int
  Winner String
  Code   String
}

model FavTeamList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  favTeams  FavTeams
}

type FavTeams {
  F1   String?
  NFL  String?
  NBA  String?
  MLB  String?
  NHL  String?
  MLS  String?
  WNBA String?
  CFL  String?
  UFL  String?
  IFL  String?
  NGL  String?
  AAA  String?
  AA   String?
  HA   String?
  SA   String?
  AHL  String?
  ECHL String?
  PWHL String?
  MLV  String?
}
